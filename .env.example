# ============================================================
# Martin Quant — Environment Variables Example
# 複製此檔為 .env 並填入真實設定
# ============================================================

# ------ Telegram 通知 ------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ------ 資金管理 ------
ACCOUNT_EQUITY=100000
ACCOUNT_LIVE=false              # true = 真實交易, false = 模擬
MAX_RISK_PER_TRADE=0.01         # 1% of equity per trade
MAX_OPEN_POSITIONS=5

# ------ Data Provider ------
# yfinance (default, 免費)
# DATA_PROVIDER=yfinance

# Alpaca (optional)
# DATA_PROVIDER=alpaca
# ALPACA_API_KEY=your_key
# ALPACA_SECRET_KEY=your_secret
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ------ IBKR (optional) ------
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1

# ------ 掃描設定 ------
SCAN_REGIME=auto                # auto | BULL | WEAK_BULL | CHOPPY | BEAR
SCAN_MIN_SCORE=0.60             # 最低信號分數門溻
SCAN_MAX_RESULTS=10

# ------ 路徑設定 ------
TRADES_CSV_PATH=trades.csv
REPORTS_DIR=reports
